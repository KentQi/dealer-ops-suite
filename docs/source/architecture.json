  "cards": [
    {
      "dot": "cyan",
      "title": "范围",
      "items": [
        "订单、发货、签收在业务系统完成，不在本 Skill 内",
        "直接买断立即阻断，不套用两种引擎公式",
        "不绑定特定 harness；入口统一为 Agent Harness"
      ]
    },
    {
      "dot": "rose",
      "title": "不可绕过的门禁",
      "items": [
        "合同写前 --approve-write、最终 --release、verify_fill 三段验收",
        "主档 A3 确认：抽取结果只是候选，普通 JSON 不能直接落库",
        "政策 blocker 不降级；blocker=0 且 high 逐条登记才可放行"
      ]
    },
    {
      "dot": "violet",
      "title": "统一口径与闭环",
      "items": [
        "铺货代销与月结买断分开计货款与贴花，共享列/条码/舍入内核",
        "金额逐笔 ROUND_HALF_UP 到分，合计只汇总已舍入明细",
        "B5 回写先 dry-run 再 --write；未回写期间表视为流程未完成"
      ]
    }
  ]
