      "where": "第六条第 4 款「(2) 联系人：」",
      "required": true,
      "format": "姓名，2-15 字",
      "example": "王五",
      "target": {
        "kind": "para",
        "index": 98,
        "anchor": "(2) 联系人：",
        "occurrence": 1
      },
      "mode": "append",
      "render": "{v}",
      "vtype": "person"
    },
    {
      "id": "DX-20",
      "label": "收货联系电话",
      "where": "第六条第 4 款「(3) 联系电话：」",
      "required": true,
      "format": "手机 11 位或座机含区号",
      "example": "13900139000",
      "target": {
        "kind": "para",
        "index": 99,
        "anchor": "(3) 联系电话：",
        "occurrence": 1
      },
      "mode": "append",
      "render": "{v}",
      "vtype": "phone"
    },
    {
      "id": "DX-21",
      "label": "季度返利",
      "where": "第七条第 1 款（4）「季度返利：＿＿＿%」",
      "required": true,
      "format": "百分数数值，0-30 之间，可含一位小数；填 0 表示无返利",
      "example": "3",
      "target": {
        "kind": "para",
        "index": 118,
        "anchor": "季度返利：",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "季度返利：＿+\\s*%",
