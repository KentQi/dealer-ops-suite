      "vtype": "percent_rebate"
    },
    {
      "id": "DX-23",
      "label": "签订时间",
      "where": "签章页「签订时间：　年　月　日」",
      "required": true,
      "format": "YYYY-MM-DD；须落在合同期限起始日之前或当日",
      "example": "2026-10-20",
      "target": {
        "kind": "para",
