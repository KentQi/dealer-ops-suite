{
  "doc_key": "DX",
  "title": "示例品牌经销合同（铺货代销版）",
  "version": "1.0.0",
  "fields": [
    {
      "id": "DX-01",
      "label": "主合同编号",
      "where": "首页抬头「主合同编号：」",
      "required": true,
      "format": "四段式「品牌码-类型码-年份-序号」，如 DM-DX-2026-001；可带扩展段（DM-DX-JS-2026-001）；仅大写字母、数字、半角连字符；未定可填「待定」",
      "example": "DM-DX-2026-001",
      "target": {
        "kind": "para",
        "index": 13,
        "anchor": "主合同编号：",
        "occurrence": 1
      },
      "mode": "append",
      "render": "{v}",
      "vtype": "contract_no"
    },
    {
      "id": "DX-02",
      "label": "乙方公司全称",
      "where": "首页「经销商：＿＿＿＿（以下简称乙方）」",
      "required": true,
      "format": "与营业执照完全一致的全称，含括号须用中文全角括号",
      "example": "示例经销商有限公司",
      "target": {
        "kind": "para",
        "index": 26,
        "anchor": "（以下简称乙方）",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "＿{3,}",
      "render": "{v}",
      "vtype": "company"
    },
    {
      "id": "DX-03",
      "label": "乙方统一社会信用代码",
      "where": "首页乙方信息栏",
      "required": true,
      "format": "18 位，大写字母+数字；须通过 GB32100 校验位",
      "example": "91330100MA2C00000P",
      "target": {
        "kind": "para",
        "index": 27,
        "anchor": "统一社会信用代码：",
        "occurrence": 2
      },
      "mode": "append",
      "render": "{v}",
      "vtype": "uscc"
    },
    {
      "id": "DX-04",
      "label": "乙方联系人",
      "where": "首页乙方信息栏",
      "required": true,
      "format": "姓名，2-15 字",
      "example": "张三",
      "target": {
        "kind": "para",
        "index": 28,
        "anchor": "联系人：",
        "occurrence": 2
      },
      "mode": "append",
      "render": "{v}",
      "vtype": "person"
    },
    {
      "id": "DX-05",
      "label": "乙方通讯地址",
      "where": "首页乙方信息栏",
      "required": true,
      "format": "省+市+区+详细地址，须含门牌号",
      "example": "示例市示例区XX路XX号",
      "target": {
        "kind": "para",
        "index": 29,
        "anchor": "通讯地址：",
        "occurrence": 2
      },
      "mode": "append",
      "render": "{v}",
      "vtype": "address"
    },
    {
      "id": "DX-06",
      "label": "经销区域-省",
      "where": "第一条第 1 款",
      "required": true,
      "format": "省级行政区名称，不带「省」字（模板已含）",
      "example": "示例",
      "target": {
        "kind": "para",
        "index": 35,
        "anchor": "甲方授权乙方为",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "＿+省",
      "render": "{v}省",
      "vtype": "region"
    },
    {
      "id": "DX-07",
      "label": "经销区域-市",
      "where": "第一条第 1 款",
      "required": true,
      "format": "地级市名称，不带「市」字（模板已含）",
      "example": "示例",
      "target": {
        "kind": "para",
        "index": 35,
        "anchor": "甲方授权乙方为",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "＿+市",
      "render": "{v}市",
      "vtype": "region"
    },
    {
      "id": "DX-08",
      "label": "经销区域-系统/渠道",
      "where": "第一条第 1 款",
      "required": true,
      "format": "授权渠道或系统名称，模板自动补「系统经销商」",
      "example": "示例渠道专营店",
      "target": {
        "kind": "para",
        "index": 35,
        "anchor": "甲方授权乙方为",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "＿{2,}(?:\\s+＿)*\\s*系统经销商",
      "render": "{v}系统经销商",
      "warning": "该模板此处的下划线中间夹有空格（＿＿＿  ＿），属模板排版瑕疵，脚本已兼容；建议下版修正。",
      "vtype": "channel"
    },
    {
      "id": "DX-09",
      "label": "合同期限-起始日",
      "where": "第一条第 2 款「自　年　月　日」",
      "required": true,
      "format": "YYYY-MM-DD；须早于终止日",
      "example": "2026-11-01",
      "target": {
        "kind": "para",
        "index": 36,
        "anchor": "2.合同期限：",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "自\\s+年\\s+月\\s+日",
      "render": "自 {y} 年 {m} 月 {d} 日",
      "vtype": "date"
    },
    {
      "id": "DX-10",
      "label": "合同期限-终止日",
      "where": "第一条第 2 款「至　年　月　日止」",
      "required": true,
      "format": "YYYY-MM-DD；须晚于起始日",
      "example": "2027-10-31",
      "target": {
        "kind": "para",
        "index": 36,
        "anchor": "2.合同期限：",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "至\\s+年\\s+月\\s+日止",
      "render": "至 {y} 年 {m} 月 {d} 日止",
      "vtype": "date"
    },
    {
      "id": "DX-11",
      "label": "履约保证金-大写",
      "where": "第二条第 1 款",
      "required": false,
      "format": "中文大写金额，须与小写一致；模板默认「壹万元」",
      "example": "壹万元",
      "default": "壹万元",
      "target": {
        "kind": "para",
        "index": 47,
        "anchor": "履约保证金标准：",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "（大写）(.+?)（",
      "render": "（大写）{v}（",
      "vtype": "amount_cn"
    },
    {
      "id": "DX-12",
      "label": "履约保证金-小写",
      "where": "第二条第 1 款",
      "required": false,
      "format": "阿拉伯数字整数，须与大写一致；模板默认 10000",
      "example": "10000",
      "default": "10000",
      "target": {
        "kind": "para",
        "index": 47,
        "anchor": "履约保证金标准：",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "￥\\s*[\\d,]+\\s*元",
      "render": "￥ {v} 元",
      "vtype": "amount_num"
    },
    {
      "id": "DX-13",
      "label": "铺货额度",
      "where": "第五条第 1 款（4）「不超过人民币＿＿＿＿万元」",
      "required": true,
      "format": "正数，单位万元；可含一位小数",
      "example": "20",
      "target": {
        "kind": "para",
        "index": 74,
        "anchor": "（4）铺货额度",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "人民币＿+\\s*万元",
      "render": "人民币{v}万元",
      "vtype": "amount_wan"
    },
    {
      "id": "DX-14",
      "label": "动销保障比例",
      "where": "第五条第 1 款（7）①「不超过当季发货总金额的　　%」",
      "required": true,
      "format": "百分数数值，0-100；常见 10-30",
      "example": "20",
      "target": {
        "kind": "para",
        "index": 78,
        "anchor": "①动销保障",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "总金额的\\s+%",
      "render": "总金额的 {v}%",
      "vtype": "percent_any"
    },
    {
      "id": "DX-15",
      "label": "结款期限（每月几日前）",
      "where": "第五条第 1 款（9）「乙方应于每月　日前」",
      "required": true,
      "format": "1-28 的整数（建议不超过 28，避免月末无此日）",
      "example": "15",
      "target": {
        "kind": "para",
        "index": 83,
        "anchor": "（9）结款期限",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "每月\\s+日前",
      "render": "每月 {v} 日前",
      "vtype": "day"
    },
    {
      "id": "DX-16",
      "label": "对账联系人",
      "where": "第五条第 2 款「1)联系人：」",
      "required": true,
      "format": "姓名，2-15 字；可与乙方联系人相同",
      "example": "李四",
      "target": {
        "kind": "para",
        "index": 86,
        "anchor": "1)联系人：",
        "occurrence": 1
      },
      "mode": "append",
      "render": "{v}",
      "vtype": "person"
    },
    {
      "id": "DX-17",
      "label": "对账联系电话",
      "where": "第五条第 2 款「2)联系电话：」",
      "required": true,
      "format": "手机 11 位或座机含区号",
      "example": "13800138000",
