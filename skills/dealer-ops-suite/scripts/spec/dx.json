      "vtype": "percent_rebate"
    },
    {
      "id": "DX-22",
      "label": "年度返利",
      "where": "第七条第 1 款（4）「年度返利：＿＿＿%」",
      "required": true,
      "format": "百分数数值，0-30 之间，可含一位小数；通常不低于季度返利",
      "example": "2",
      "target": {
        "kind": "para",
        "index": 119,
        "anchor": "年度返利：",
        "occurrence": 1
      },
      "mode": "regex",
      "pattern": "年度返利：＿+\\s*%",
